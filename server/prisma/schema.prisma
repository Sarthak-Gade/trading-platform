generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ==========================================
// AUTH & USER
// ==========================================
enum Role {
  USER
  ADMIN
}
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  mobNumber    String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Set when the user proves they own the email address / mobile number with a one-time code
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  // Wrong-password counter; at 5 the account is locked until lockedUntil
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  account      Account?
  banks        Bank[]
  orders       Order[]
  trades       Trade[]
  positions    Position[]
  holdings     Holding[]
  watchlists   Watchlist[]
  alerts       Alert[]
  balance      Balance?
  transactions Transaction[]
  otpCodes     OtpCode[]
}

// One-time codes for email verification, mobile verification and password reset.
// Only a hash of the code is stored.
model OtpCode {
  id        String   @id @default(uuid())
  purpose   String   // "verify_email" | "verify_mobile" | "reset_password"
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // A new code for the same purpose replaces the old one
  @@unique([userId, purpose])
}

model Balance {
  id               String  @id @default(uuid())
  availableBalance Decimal @default(0)
  usedMargin       Decimal @default(0)

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Transaction {
  id             String   @id @default(uuid())
  type           String   // "deposit" | "withdrawal" | "trade_debit" | "trade_credit" | "charges"
  description    String
  amount         Decimal  // positive for credit, negative for debit
  runningBalance Decimal
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Account {
  id               String   @id @default(uuid())
  dob              DateTime
  pan_no           String   @unique
  gender           String?
  maritalStatus    String?
  occupation       String?
  incomeRange      String?
  uniqueClientCode String   @unique

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// ==========================================
// MARKET DATA (reference table)
// ==========================================

model Instrument {
  id       String @id @default(uuid())
  symbol   String @unique
  name     String
  type     String // "EQUITY" | "FUTURE" | "OPTION" | "MF"
  exchange String // "NSE" | "BSE"
  lotSize  Int    @default(1)

  orders    Order[]
  trades    Trade[]
  positions Position[]
  holdings  Holding[]
  alerts    Alert[]
  watchlistItems WatchlistItem[]
}

// ==========================================
// TRADING CORE
// ==========================================

model Order {
  id           String   @id @default(uuid())
  type         String   // "buy" | "sell"
  orderType    String   // "market" | "limit" | "GTT" | "AMO"
  productType  String   @default("CNC") // "CNC" (delivery) | "MIS" (intraday) | "NRML" (F&O carry)
  qty          Int
  orderPrice   Decimal
  status       String   @default("pending") // pending | executed | cancelled
  validity     String   // "DAY" | "IOC"
  createdAt    DateTime @default(now())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
  trades Trade[]
}

model Trade {
  id            String   @id @default(uuid())
  pricePerShare Decimal
  sharesQty     Int
  totalPrice    Decimal
  brokerage     Decimal  @default(0)
  // Regulatory charges, added with the Indian charges engine. Older trades keep 0 here.
  stt             Decimal @default(0)
  exchangeCharges Decimal @default(0)
  sebiCharges     Decimal @default(0)
  gst             Decimal @default(0)
  stampDuty       Decimal @default(0)
  executedAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id])
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
  order        Order      @relation(fields: [orderId], references: [id])
  orderId      String
}

model Position {
  id            String  @id @default(uuid())
  productType   String  // "MIS" | "NRML"
  netQty        Int
  avgPrice      Decimal
  realizedPnl   Decimal @default(0)
  unrealizedPnl Decimal @default(0)

  user         User       @relation(fields: [userId], references: [id])
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
}

model Holding {
  id            String  @id @default(uuid())
  qty           Int
  investedValue Decimal
  currentValue  Decimal @default(0)

  user         User       @relation(fields: [userId], references: [id])
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
}

// ==========================================
// BANKS
// ==========================================

model Bank {
  id            String @id @default(uuid())
  accountNumber String
  ifscCode      String
  bankBranch    String
  status        String @default("pending") // pending | verified

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

// ==========================================
// WATCHLIST
// ==========================================

model Watchlist {
  id   String @id @default(uuid())
  name String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  items WatchlistItem[]
}

model WatchlistItem {
  id String @id @default(uuid())

  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id])
  watchlistId  String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
}

model Alert {
  id            String   @id @default(uuid())
  triggerPrice  Decimal
  condition     String   // "above" | "below"
  status        String   @default("active") // "active" | "triggered"
  createdAt     DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id])
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
}
